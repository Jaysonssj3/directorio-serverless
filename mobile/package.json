{
  "name": "directorio-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/tests/*.test.js",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios --output-dir dist-ios"
  },
  "dependencies": {
    "expo": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "expo-secure-store": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-image-manipulator": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-build-properties": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
